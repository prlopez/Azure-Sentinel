{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "metadata": {
        "title": "Zscaler OAuth2 Authentication (Legacy)",
        "description": "Obtains an OAuth2 access token for Zscaler using a direct token URL (e.g., Entra ID) and returns it together with the ZIA API base_url for downstream playbooks.",
        "mainSteps": [
            "1. Requests an access token from the configured OAuth2 token endpoint using client credentials and scope",
            "2. Returns the token response with base_url to the caller"
        ],
        "prerequisites": [
            "1. Zscaler subscription with legacy API access enabled",
            "2. Client ID, Client Secret, Token URL, OAuth Scope, and Zscaler cloud (Base URL)"
        ],
        "lastUpdateTime": "2025-09-02T00:00:00.000Z",
        "entities": [],
        "tags": [
            "Utilities"
        ],
        "support": {
            "tier": "Partner"
        },
        "author": {
            "name": "Zscaler"
        },
        "source": {
            "type": "solution",
            "name": "Zscaler Internet Access"
        },
        "postDeployment": [
            "**a. Validate**",
            "Trigger the playbook and confirm a token and base_url are returned."
        ],
        "releaseNotes": [
            {
                "version": "1.0.0",
                "title": "Zscaler OAuth2 Authentication - Legacy",
                "notes": [
                    "Legacy/direct-token-URL authentication only \u2014 for OneAPI (ZIdentity) tenants use the OneAPI auth playbook"
                ]
            }
        ]
    },
    "parameters": {
        "PlaybookName": {
            "defaultValue": "Zscaler-Oauth2-Legacy-Authentication",
            "type": "string",
            "minLength": 1,
            "metadata": {
                "description": "Name of the Logic App/Playbook"
            }
        },
        "Legacy_ClientId": {
            "type": "string",
            "minLength": 1,
            "metadata": {
                "description": "Entra ID Application (Client) ID for the ZIA API Playbooks app registration."
            }
        },
        "Legacy_ClientSecret": {
            "type": "securestring",
            "minLength": 1,
            "metadata": {
                "description": "Entra ID Client Secret for the ZIA API Playbooks app registration."
            }
        },
        "Legacy_TokenUrl": {
            "type": "string",
            "minLength": 1,
            "metadata": {
                "description": "OAuth2 token endpoint URL (e.g., https://<idp-host>/<tenant-id>/oauth2/v2.0/token)."
            }
        },
        "Legacy_OAuthScope": {
            "type": "string",
            "minLength": 1,
            "metadata": {
                "description": "OAuth2 scope \u2014 Application ID URI from your ZIA API Web Service app registration appended with /.default."
            }
        },
        "Legacy_BaseUrl": {
            "defaultValue": "zsapi.zscaler.net/api/v1",
            "type": "string",
            "allowedValues": [
                "zsapi.zscaler.net/api/v1",
                "zsapi.zscalertwo.net/api/v1",
                "zsapi.zscalerthree.net/api/v1",
                "zsapi.zscloud.net/api/v1",
                "zsapi.zscalerbeta.net/api/v1",
                "zsapi.zscalergov.net/api/v1"
            ],
            "metadata": {
                "description": "Select your Zscaler cloud."
            }
        }
    },
    "variables": {},
    "resources": [
        {
            "type": "Microsoft.Logic/workflows",
            "apiVersion": "2017-07-01",
            "name": "[parameters('PlaybookName')]",
            "location": "[resourceGroup().location]",
            "tags": {
                "auth": "Oauth2",
                "hidden-SentinelTemplateName": "Zscaler-Oauth2-Legacy-Authentication",
                "hidden-SentinelTemplateVersion": "1.0"
            },
            "identity": {
                "type": "SystemAssigned"
            },
            "properties": {
                "state": "Enabled",
                "definition": {
                    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
                    "contentVersion": "1.0.0.0",
                    "parameters": {
                        "clientId": {
                            "defaultValue": "[parameters('Legacy_ClientId')]",
                            "type": "String"
                        },
                        "clientSecret": {
                            "defaultValue": "[parameters('Legacy_ClientSecret')]",
                            "type": "SecureString"
                        },
                        "oauthUrl": {
                            "defaultValue": "[parameters('Legacy_TokenUrl')]",
                            "type": "String"
                        },
                        "scope": {
                            "defaultValue": "[parameters('Legacy_OAuthScope')]",
                            "type": "String"
                        },
                        "zscalerBaseUrl": {
                            "defaultValue": "[parameters('Legacy_BaseUrl')]",
                            "type": "String"
                        }
                    },
                    "triggers": {
                        "manual": {
                            "type": "Request",
                            "kind": "Http",
                            "inputs": {}
                        }
                    },
                    "actions": {
                        "HTTP_Legacy_Token": {
                            "runAfter": {},
                            "type": "Http",
                            "inputs": {
                                "body": "grant_type=client_credentials&client_id=@{encodeUriComponent(parameters('clientId'))}&client_secret=@{encodeUriComponent(parameters('clientSecret'))}&scope=@{encodeUriComponent(parameters('scope'))}",
                                "headers": {
                                    "Content-Type": "application/x-www-form-urlencoded"
                                },
                                "method": "POST",
                                "uri": "@parameters('oauthUrl')"
                            },
                            "runtimeConfiguration": {
                                "secureData": {
                                    "properties": [
                                        "inputs",
                                        "outputs"
                                    ]
                                }
                            }
                        },
                        "Build_Response_Body": {
                            "runAfter": {
                                "HTTP_Legacy_Token": [
                                    "Succeeded"
                                ]
                            },
                            "type": "Compose",
                            "inputs": "@addProperty(body('HTTP_Legacy_Token'), 'base_url', parameters('zscalerBaseUrl'))"
                        },
                        "Parse_Token_Response": {
                            "runAfter": {
                                "Build_Response_Body": [
                                    "Succeeded"
                                ]
                            },
                            "type": "ParseJson",
                            "inputs": {
                                "content": "@outputs('Build_Response_Body')",
                                "schema": {
                                    "properties": {
                                        "access_token": {
                                            "type": "string"
                                        },
                                        "base_url": {
                                            "type": "string"
                                        },
                                        "expires_in": {
                                            "type": "integer"
                                        },
                                        "ext_expires_in": {
                                            "type": "integer"
                                        },
                                        "token_type": {
                                            "type": "string"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        },
                        "Response": {
                            "runAfter": {
                                "Parse_Token_Response": [
                                    "Succeeded"
                                ]
                            },
                            "type": "Response",
                            "kind": "Http",
                            "inputs": {
                                "body": "@outputs('Build_Response_Body')",
                                "headers": {
                                    "Content-Type": "application/json"
                                },
                                "statusCode": 200
                            }
                        }
                    },
                    "outputs": {}
                },
                "parameters": {}
            }
        }
    ]
}
